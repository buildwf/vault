{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["convex/**/*.ts", "scripts/**/*.ts", "src/**/*.ts", "cloudflare.config.ts", ".cloudflare/types/index.d.ts"],
  "exclude": ["src/collection/form.ts", "src/agent/panel/panel.ts"]
}
