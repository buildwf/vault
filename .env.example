# Copy to .env (gitignored) and fill in your own Cloudflare ids.
# cloudflare.config.ts, the package.json scripts and the operator scripts read
# these; the real environment wins over this file.

# Required for --mode production (deploy, migrations:production, ops scripts).
# Account: `bunx cf auth whoami`. Secrets Store: `bunx cf secrets-store stores list`.
CLOUDFLARE_ACCOUNT_ID=
VAULT_SECRETS_STORE_ID=

# Required for production. `bunx cf d1 list`.
VAULT_D1_ID=

# Optional; the defaults are shown.
# VAULT_WORKER_NAME=bwf-vault
# VAULT_D1_NAME=bwf-vault
# Secrets Store names are <prefix>_MASTER_KEY_PRIMARY, <prefix>_MASTER_KEY_SECONDARY
# and <prefix>_BOOTSTRAP_TOKEN.
# VAULT_SECRET_PREFIX=BWF_VAULT
