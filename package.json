{
  "name": "@build-with-friends/vault-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "vault": "src/cli.ts"
  },
  "scripts": {
    "build:cli": "bun scripts/build-cli.ts",
    "cli": "bun src/cli.ts",
    "dev": "cf dev",
    "deploy": "cf deploy --mode production",
    "deploy:dry-run": "cf deploy --mode production --dry-run",
    "install:cli": "bun run build:cli && bun scripts/install-cli.ts",
    "migrations:local": "cf d1 migrations apply 00000000-0000-4000-8000-00000000d1d1 --local --persist-to .wrangler/state",
    "migrations:production": "bun scripts/migrations-production.ts",
    "recovery:rehearse": "bun scripts/recovery-rehearsal.ts",
    "master-keys:prepare-rotation": "bun scripts/rotate-master-key.ts prepare --yes",
    "acceptance": "bun scripts/acceptance.ts",
    "acceptance:collection": "bun scripts/collection-acceptance.ts",
    "check": "cf workers types && tsc --noEmit && tsc --noEmit -p tsconfig.browser.json && bun run deploy:dry-run",
    "test": "bun test src",
    "types": "cf workers types",
    "uninstall:cli": "bun scripts/uninstall-cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "latest",
    "hono": "latest",
    "valibot": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "ts6.0",
    "cf": "1.0.0-beta.10",
    "playwright": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
